services:

  bronze-streaming:
    image: naveen9200/retailhub-spark-streaming:4.2.0
    container_name: retailhub-bronze-streaming
    user: root
    restart: unless-stopped

    env_file:
      - .env

    environment:
      KAFKA_BROKER: ${KAFKA_BROKER}
      BRONZE_PATH: ${BRONZE_PATH}
      BRONZE_CHECKPOINT_PATH: ${BRONZE_CHECKPOINT_PATH}

    volumes:
      - ./data:/opt/retailhub/data
      - ./logs:/opt/retailhub/logs

    command:
      - spark-submit
      - /opt/retailhub/src/streaming/kafka_to_bronze.py


  fraud-streaming:
    image: naveen9200/retailhub-spark-streaming:4.2.0
    container_name: retailhub-fraud-streaming
    user: root
    restart: unless-stopped

    env_file:
      - .env

    environment:
      KAFKA_BROKER: ${KAFKA_BROKER}
      FRAUD_CHECKPOINT_PATH: ${FRAUD_CHECKPOINT_PATH}

      FRAUDGUARD_DATA_PATH: /opt/retailhub/data/fraudguard
      FRAUDGUARD_SIGNAL_PATH: /opt/retailhub/data/fraudguard/signals
      FRAUDGUARD_INCIDENT_PATH: /opt/retailhub/data/fraudguard/incidents
      FRAUDGUARD_STATE_PATH: /opt/retailhub/data/fraudguard/state
      FRAUDGUARD_AUDIT_PATH: /opt/retailhub/data/fraudguard/audit
      FRAUDGUARD_EVIDENCE_PATH: /opt/retailhub/data/fraudguard/evidence
      FRAUDGUARD_LOG_PATH: /opt/retailhub/logs/fraudguard

    volumes:
      - ./data:/opt/retailhub/data
      - ./logs:/opt/retailhub/logs

    command:
      - spark-submit
      - /opt/retailhub/src/streaming/fraud_consumer.py



      and .env

      KAFKA_BROKER=10.0.139.252:9092

KAFKA_TOPIC_PATTERN=retail_.*
FRAUD_TOPIC_PATTERN=retail_(admin|cart|checkout|coupon|discovery|fulfillment|order|payment|return|review|system|user)_events

FRAUDGUARD_DECISION_TOPIC=retail_fraudguard_events

BRONZE_PATH=s3a://retailhub-bronze-252bda/
QUARANTINE_PATH=s3a://retailhub-quarantine-252bda/events

BRONZE_CHECKPOINT_PATH=s3a://retailhub-checkpoints-252bda/bronze/
FRAUD_CHECKPOINT_PATH=s3a://retailhub-checkpoints-252bda/fraud_detection_v4

FRAUDGUARD_DATA_PATH=/opt/retailhub/data/fraudguard
FRAUDGUARD_SIGNAL_PATH=/opt/retailhub/data/fraudguard/signals
FRAUDGUARD_INCIDENT_PATH=/opt/retailhub/data/fraudguard/incidents
FRAUDGUARD_STATE_PATH=/opt/retailhub/data/fraudguard/state
FRAUDGUARD_AUDIT_PATH=/opt/retailhub/data/fraudguard/audit
FRAUDGUARD_EVIDENCE_PATH=/opt/retailhub/data/fraudguard/evidence
FRAUDGUARD_LOG_PATH=/opt/retailhub/logs/fraudguard